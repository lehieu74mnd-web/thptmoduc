rules_version = '2';

// QUY TẮC BẢO MẬT CHO KHO VIDEO (Firebase Storage) – website Chạm
// Ai cũng xem được video; chỉ giáo viên đã được cấp quyền mới tải lên / xóa.
// Email quản trị phải giống ownerEmail trong js/config.js.

service firebase.storage {
  match /b/{bucket}/o {

    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return request.auth != null && myEmail() == "lehieu74mnd@gmail.com"; }
    function tPath() { return /databases/(default)/documents/teachers/$(myEmail()); }
    function isTeacher() {
      return isOwner()
        || (request.auth != null && firestore.exists(tPath()) && firestore.get(tPath()).data.active == true);
    }

    match /videos/{file} {
      allow read: if true;
      allow create: if isTeacher()
        && request.resource.size < 300 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if isTeacher();
    }
  }
}
