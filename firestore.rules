rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // THAY bằng email Google của QUẢN TRỊ (đăng bài + trả lời tin nhắn)
    function admin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'quantri@gmail.com'
        ];
    }

    // THAY bằng email Google của thầy cô Tổ Tư vấn (chỉ trả lời tin nhắn)
    function staff() {
      return admin()
        || (signedIn()
            && request.auth.token.email_verified == true
            && request.auth.token.email in [
              'thaycoa@gmail.com',
              'thayb@gmail.com'
            ]);
    }

    function validPost(d) {
      return d.keys().hasOnly(['sec','title','body','link','ts'])
        && d.sec in ['tb','2','3.2','3.3']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 5000
        && d.link is string && d.link.size() <= 500;
    }

    // Bài đăng: ai cũng đọc được; chỉ quản trị mới đăng/sửa/xóa
    match /posts/{p} {
      allow read: if true;
      allow create: if admin() && validPost(request.resource.data) && request.resource.data.ts == request.time;
      allow update: if admin() && validPost(request.resource.data) && request.resource.data.ts == resource.data.ts;
      allow delete: if admin();
    }

    // ===== Trợ lý / tin nhắn học sinh cũ (bộ sưu tập Messenger) =====
    function validMsg(d) {
      return d.noiDung is string && d.noiDung.size() > 0 && d.noiDung.size() <= 2000
        && !d.keys().hasAny(['traLoiGV'])
        && (!d.keys().hasAny(['trangThai']) || d.trangThai != 'da_tra_loi');
    }
    match /Messenger/{id} {
      allow get: if true;            // học sinh xem lại tin của mình theo mã tài liệu (khó đoán)
      allow list: if staff();        // chỉ giáo viên xem toàn bộ danh sách
      allow create: if validMsg(request.resource.data);   // học sinh gửi tin, không tự điền câu trả lời
      allow update, delete: if staff();                   // chỉ giáo viên trả lời / xóa
    }

    match /threads/{id} {
      allow get: if signedIn();          // biết mã bí mật (id) mới mở được
      allow list: if staff();            // chỉ giáo viên xem danh sách

      allow create: if signedIn()
        && id.size() == 8
        && request.resource.data.keys().hasOnly(['khoi','van_de','createdAt','lastAt','lastFrom','urgent','status'])
        && request.resource.data.lastFrom == 'hs'
        && request.resource.data.status == 'open'
        && request.resource.data.khoi is string && request.resource.data.khoi.size() <= 20
        && request.resource.data.van_de is string && request.resource.data.van_de.size() <= 60
        && request.resource.data.createdAt == request.time;

      allow update: if staff()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt','lastFrom','urgent','status'])
            && request.resource.data.lastFrom == 'hs'
            && request.resource.data.status == 'open');

      match /messages/{m} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from','text','at','uid'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && (request.resource.data.from == 'hs' || (request.resource.data.from == 'gv' && staff()));
      }
    }
  }
}
