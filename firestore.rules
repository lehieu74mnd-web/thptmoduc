rules_version = '2';

// QUY TẮC BẢO MẬT CHO WEBSITE CHẠM
// Trước khi dán vào Firebase Console, thay EMAIL_QUAN_TRI@gmail.com bằng email quản trị viên chính
// (giống giá trị ownerEmail trong js/config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && myEmail() == "EMAIL_QUAN_TRI@gmail.com"; }
    function tPath() { return /databases/$(database)/documents/teachers/$(myEmail()); }
    function isTeacher() {
      return isOwner() || (signedIn() && exists(tPath()) && get(tPath()).data.active == true);
    }
    function isAdmin() {
      return isOwner() || (isTeacher() && get(tPath()).data.role == "admin");
    }
    function shortText(v, n) { return v is string && v.size() <= n; }

    // Cài đặt trang: ai cũng xem được, quản trị viên sửa
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bài viết: bài đã đăng ai cũng xem; giáo viên viết, sửa, xóa; khách chỉ được tăng lượt xem
    match /posts/{id} {
      allow read: if resource.data.published == true || isTeacher();
      allow create, delete: if isTeacher();
      allow update: if isTeacher()
        || (resource.data.published == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])
            && request.resource.data.views == resource.data.views + 1);
    }

    // Danh sách giáo viên
    match /teachers/{email} {
      allow read: if isTeacher();
      allow write: if isAdmin();
      allow update: if signedIn() && email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["must_change"]);
    }

    // Học sinh: mỗi mã tra cứu là một "hộp thư" riêng, ai biết mã mới mở được.
    // Không ai (trừ giáo viên) liệt kê được danh sách mã.
    match /students/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if code.size() == 16 && request.resource.data.keys().hasOnly(["created_at"]);

      match /threads/{tid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(["topic", "display_name", "class_name", "anonymous", "urgent",
                            "status", "teacher_unread", "student_unread", "created_at", "updated_at", "last"])
                      && shortText(request.resource.data.topic, 30)
                      && shortText(request.resource.data.display_name, 60)
                      && shortText(request.resource.data.class_name, 20)
                      && request.resource.data.status == "open";
        allow update: if isTeacher()
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["student_unread", "teacher_unread", "updated_at", "last", "status"]);
        allow delete: if isAdmin();

        match /messages/{mid} {
          allow read: if true;
          allow create: if shortText(request.resource.data.body, 6000) && request.resource.data.body.size() > 0
            && (request.resource.data.sender == "student" || (isTeacher() && request.resource.data.sender == "teacher"));
          allow delete: if isAdmin();
        }
      }
    }

    // Hộp thư giáo viên: xem toàn bộ cuộc trò chuyện của mọi học sinh
    match /{path=**}/threads/{tid} {
      allow read: if isTeacher();
    }
  }
}
